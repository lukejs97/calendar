# Copy this file to `.env` (same folder) and fill in the values from
# Google Cloud Console > Google Auth Platform > Clients > your Desktop client.
# `.env` is git-ignored. Rebuild the app after changing it.
GOOGLE_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-replace-me

# iOS builds: the "iOS" client from the same page (iOS clients have no secret).
GOOGLE_IOS_CLIENT_ID=1234567890-xyz789.apps.googleusercontent.com

# Optional. Traffic for leave-by times (docs/google-cloud-setup.md). Read when
# the app runs, in development builds only — it is not compiled in. Settings
# can save a key instead. A real environment variable of this name wins over both.
# MINUTEMAN_ROUTES_API_KEY=
